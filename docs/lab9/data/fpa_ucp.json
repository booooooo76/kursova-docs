 "use_cases": [
  {
   "id": "UC1",
   "name": "Подати заяву на рецензію",
   "actor": "Заявник",
   "source": "submit_filing_for_review (DRAFT)",
   "steps": [
    "перевірити staffApprovalRequired і статус DRAFT",
    "створити Review(AWAITING_REVIEW)",
    "скопіювати nrNumber, identifier, contactEmail із заяви",
    "зберегти Review",
    "перевести Filing в AWAITING_REVIEW",
    "надіслати подію листа в Emailer"
   ],
   "weight": 10
  },
  {
   "id": "UC2",
   "name": "Повторно подати після запиту змін",
   "actor": "Заявник",
   "source": "submit_filing_for_review (CHANGE_REQUESTED)",
   "steps": [
    "перевірити статус CHANGE_REQUESTED",
    "знайти Review за filing_id",
    "встановити RESUBMITTED",
    "оновити submission_date останнього ReviewResult",
    "оновити поля й зберегти Review",
    "перевести Filing в AWAITING_REVIEW",
    "надіслати подію листа в Emailer"
   ],
   "weight": 10
  },
  {
   "id": "UC3",
   "name": "Переглянути чергу рецензій",
   "actor": "Staff-рецензент",
   "source": "get_reviews",
   "steps": [
    "перевірити роль staff",
    "зібрати ReviewFilter із 10 параметрів",
    "зіставити колонку сортування",
    "відфільтрувати, відсортувати, розбити на сторінки",
    "вибрати NR в активних статусах",
    "запитати строки дії NR у NameX",
    "додати nrExpiryDate до рецензій",
    "повернути сторінку JSON"
   ],
   "weight": 15
  },
  {
   "id": "UC4",
   "name": "Відкрити картку рецензії",
   "actor": "Staff-рецензент",
   "source": "get_review",
   "steps": [
    "перевірити роль staff",
    "знайти Review або 404",
    "завантажити Filing",
    "побудувати filingLink",
    "повернути JSON з історією рішень"
   ],
   "weight": 10
  },
  {
   "id": "UC5",
   "name": "Ухвалити рішення (схвалити / запросити зміни / відхилити)",
   "actor": "Staff-рецензент",
   "source": "save_review",
   "steps": [
    "перевірити роль staff",
    "отримати або створити User з JWT",
    "знайти Review або 404",
    "перевірити, що статус ще можна змінити",
    "перевірити новий статус",
    "вимагати коментар для CR і REJECTED",
    "створити ReviewResult",
    "оновити статус Review і зберегти",
    "встановити рішення у Filing",
    "надіслати подію листа в Emailer"
   ],
   "weight": 15
  },
  {
   "id": "UC6",
   "name": "Побачити коментар рецензента",
   "actor": "Заявник",
   "source": "get_single_filing",
   "steps": [
    "перевірити статус заяви CR / APPROVED / REJECTED",
    "взяти останній ReviewResult",
    "додати latestReviewComment у відповідь"
   ],
   "weight": 5
  }
 ],
